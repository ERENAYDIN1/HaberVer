# === PostgreSQL / PostGIS ===
POSTGRES_USER=greenasset
POSTGRES_PASSWORD=change_me
POSTGRES_DB=greenasset
POSTGRES_PORT=5432

# === Backend ===
# Not: host olarak docker-compose servis adı "db" kullanılır.
DATABASE_URL=postgresql+psycopg://greenasset:change_me@db:5432/greenasset
BACKEND_PORT=8000

# CORS için izin verilen frontend origin'i
FRONTEND_ORIGIN=http://localhost:5173

# JWT imzalama anahtarı — PRODUCTION'DA MUTLAKA DEĞİŞTİRİN.
# Verilmezse app/config.py'deki geliştirme varsayılanı kullanılır.
JWT_SECRET=change_me

# İlk admin hesabı (baseline migration 0001 ile tohumlanır; yalnızca hiç admin
# yoksa oluşur). Sisteme ilk girişi sağlayan tek hesaptır — PRODUCTION'DA
# MUTLAKA GERÇEK BİR PAROLA VERİN.
# Not: ".local" gibi alan adları email-validator tarafından reddedilir.
DEFAULT_ADMIN_EMAIL=admin@greenasset.com
DEFAULT_ADMIN_PASSWORD=change_me

# === Frontend ===
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api
