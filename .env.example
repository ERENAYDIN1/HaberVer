# === PostgreSQL / PostGIS ===
POSTGRES_USER=haberver
POSTGRES_PASSWORD=change_me
POSTGRES_DB=haberver
POSTGRES_PORT=5432

# === Backend ===
# Not: host olarak docker-compose servis adı "db" kullanılır.
DATABASE_URL=postgresql+psycopg://haberver:change_me@db:5432/haberver
BACKEND_PORT=8000

# CORS için izin verilen frontend origin'i
FRONTEND_ORIGIN=http://localhost:5173

# Uygulamanın tarayıcıdan görünen TEK origin'i. Oturum cookie'si first-party
# kalsın diye frontend, /api ve /media aynı origin'den servis edilir (dev'de
# Vite proxy'si, production'da bir reverse proxy ile). Keycloak dönüş adresi
# de buradan türetilir: <APP_BASE_URL>/api/auth/callback
APP_BASE_URL=http://localhost:5173

# İlk admin hesabı (baseline migration 0001 ile tohumlanır; yalnızca hiç admin
# yoksa oluşur). Parola artık burada değil KEYCLOAK'ta tutulur; bu e-posta
# yalnızca yerel satırla Keycloak kullanıcısını eşlemek için kullanılır.
# Not: ".local" gibi alan adları email-validator tarafından reddedilir.
DEFAULT_ADMIN_EMAIL=admin@haberver.com
DEFAULT_ADMIN_PASSWORD=change_me

# === Keycloak ===
# Konsol yöneticisi (yalnızca Keycloak yönetim arayüzü içindir, uygulama rolü değil)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me
KEYCLOAK_PORT=8081

# Tarayıcının gördüğü adres — token'daki `iss` bu olur, doğrulama buna göre yapılır.
KEYCLOAK_PUBLIC_URL=http://localhost:8081
# Backend'in docker ağı içinden gittiği adres (token/JWKS/Admin API çağrıları).
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=haberver
KEYCLOAK_CLIENT_ID=haberver-bff
# keycloak/realm-haberver.json içindeki değerle aynı olmalı.
# PRODUCTION'DA MUTLAKA DEĞİŞTİRİN (hem realm'de hem burada).
KEYCLOAK_CLIENT_SECRET=gelistirme-icin-degistir-bu-secreti

# Oturum cookie'si yalnızca HTTPS üzerinden gitsin mi? Dev'de http kullanıldığı
# için false; PRODUCTION'DA MUTLAKA true.
SESSION_COOKIE_SECURE=false

# === Frontend ===
FRONTEND_PORT=5173
# Göreli yol: istekler aynı origin'e gider, Vite proxy'si backend'e iletir
# (bkz. frontend/vite.config.ts). Cookie tabanlı oturumun ön şartı budur.
VITE_API_BASE_URL=/api
